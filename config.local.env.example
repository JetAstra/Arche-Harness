# ARCHE Harness 本地模型配置模板。复制为 config.local.env 后填写真实值；不得提交密钥。
# 这里只列当前端到端流程读取的模型、认证和检索字段。运行目录、MiniChem 端点、资源预算、
# Codex wrapper 和推理强度由标准启动脚本设置，不在共享配置中重复声明。

# 通用化学模型：Retrieval、关系比较、裁判及 MiniChem Gaussian codegen 共用。
ARCHE_CHEM_API_KEY=
ARCHE_CHEM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
ARCHE_CHEM_MODEL_NAME=deepseek-v4-pro
ARCHE_CHEM_BACKEND=openai_compatible

# GPT/Codex：Investigation，以及默认的假设形成阶段。三项独立于 ARCHE_CHEM_*，不会回退。
# 标准 API 启动模式需要完整填写；临时 local_login 实验仍保留这组配置供恢复到 API 模式。
ARCHE_CODEX_API_KEY=
ARCHE_CODEX_BASE_URL=https://your-codex-openai-compatible-endpoint.example/v1
ARCHE_CODEX_MODEL_NAME=gpt-5.6-sol

# local_login 模式可按内置 openai provider 的可用模型覆盖默认值；api 模式忽略以下两项。
ARCHE_CODEX_LOCAL_LOGIN_MODEL=gpt-5.6-sol
ARCHE_CODEX_LOCAL_LOGIN_REASONING_EFFORT=xhigh

# Agent A1：仅在启动时显式把假设形成 provider 切换为 agent_a1 时使用。
# 未设置切换开关时，假设形成继续使用上面的 GPT/Codex provider。
ARCHE_AGENT_A1_API_KEY=
ARCHE_AGENT_A1_BASE_URL=https://your-agent-a1-openai-compatible-endpoint.example/v1
ARCHE_AGENT_A1_MODEL_NAME=Agents-A1

# Investigation 任务级审查：字段名中的 CODEX 是协议兼容名称，使用独立 provider；
# 三项均不回退到 Investigation 或 ARCHE_CHEM_*。
ARCHE_REVIEW_CODEX_API_KEY=
ARCHE_REVIEW_CODEX_BASE_URL=https://your-review-openai-compatible-endpoint.example/v1
ARCHE_REVIEW_CODEX_MODEL_NAME=deepseek-v4-pro

# 本地论文检索模型目录。当前流程禁止在运行时在线下载，必须填写已存在的本地路径。
ARCHE_RETRIEVAL_MODEL_PATH=
