{
  "schema_version": 4,
  "server_name": "MiniChem Progressive Three-Layer Chemistry Toolbox",
  "exposure_policy": "progressive_discovery",
  "full_catalog_compatibility_mode": true,
  "backend_selection_policy": "per_action_explicit",
  "open_execution_policy": "agent_explicit",
  "automatic_fallback": false,
  "catalog_resource": "minichem://catalog",
  "software_resource": "minichem://software",
  "execution_policy_resource": "minichem://execution-policy",
  "execution_layers": ["predefined_actions", "native_software", "programmable_analysis"],
  "native_shell": false,
  "programmable_shell": false
}
